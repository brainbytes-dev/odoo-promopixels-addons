<odoo>
    <record id="view_move_form_brand" model="ir.ui.view">
        <field name="name">account.move.form - account_brand_layout</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="partner_shipping_id" position="before">
                <field name="brand_id"
                    invisible="move_type not in ['out_invoice', 'out_refund', 'in_invoice', 'in_refund']"
                    readonly="state != 'draft'"
                    required="is_brand_required"/>
            </field>
        </field>
    </record>
</odoo>
